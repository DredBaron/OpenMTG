# Database backend: use docker-compose.yml (PostgreSQL, default) or
# docker-compose.sqlite.yml (SQLite) - see docker-compose.sqlite.yml for
# details. This is a permanent, per-instance choice. The variables below
# are shared between both files, only the ones each file actually
# references are used.

# Only used with docker-compose.yml (PostgreSQL)
POSTGRES_DB=openmtg
POSTGRES_USER=openmtg
DB_PASSWORD=changeme
DATA_PATH=./data

# Only used with docker-compose.sqlite.yml
SQLITE_PATH=./sqlite-data

JWT_SECRET=changeme
CONFIG_PATH=./config
UPLOADS_PATH=./uploads
TRADES_PATH=./trades
